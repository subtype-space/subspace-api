{% comment %} 400x480 (520x780 on X) — too narrow for cup + text side by side, so it stacks.
  See full.liquid for how title_fit/count_scale work; target_w is this variant's real measured
  column width. Only div.layout + div.title_bar are authored here — TRMNL's platform injects the
  view/view--half_vertical wrapper itself. {% endcomment %}
{% capture title_px_raw %}{% render "title_fit", name: name, target_w: 225, c: 0.72, min_px: 14, max_px: 38 %}{% endcapture %}
{% assign title_px = title_px_raw | strip | times: 1.0 | round %}
{% capture cs_raw %}{% render "count_scale", ingredients: ingredients %}{% endcapture %}
{% assign cs = cs_raw | strip | times: 1.0 %}
{% assign gap_px = 28 | times: cs | round %}
{% assign text_px = 20 | times: cs | round %}
{% assign cup_scale = 2.2 | times: cs %}
<div class="layout layout--col">
  <div class="coffee-content flex flex--col flex--center-x flex--center-y w--full h--full" style="gap:calc({{ gap_px }}px * var(--s, 1))">
    {% render "cup", ingredients: ingredients, total_ml: total_ml, scale: cup_scale %}
    <div class="coffee-meta">
      <h3 class="coffee-title coffee-title--center" style="--fs:{{ title_px }}">{{ name }}</h3>
      {% render "ingredient_list", ingredients: ingredients, text_size: text_px %}
    </div>
  </div>
</div>

