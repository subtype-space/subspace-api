{% capture title_px_raw %}{% render "title_fit", name: name, target_w: 93, c: 0.72, min_px: 9, max_px: 18 %}{% endcapture %}
{% assign title_px = title_px_raw | strip | times: 1.5 | round %}
{% capture cs_raw %}{% render "count_scale", ingredients: ingredients %}{% endcapture %}
{% assign cs = cs_raw | strip | times: 1.0 %}
{% assign gap_px = 34 | times: cs | round %}
{% assign subtitle_px = 15 | times: cs | round %}
{% assign cup_scale = 1.6 | times: cs %}
<div class="view view--quadrant">
  <div class="layout">
    <div class="columns">
      <div class="column">
        <div class="markdown" style="height:100%;display:flex;align-items:center;">
          <div class="coffee-content coffee-layout" style="gap:calc({{ gap_px }}px * var(--s, 1))">
            {% render "cup", ingredients: ingredients, total_ml: total_ml, scale: cup_scale %}
            <div class="coffee-meta">
              <h3 class="coffee-title" style="font-size:calc({{ title_px }}px * var(--s, 1))">{{ name }}</h3>
              <p class="coffee-subtitle" style="font-size:calc({{ subtitle_px }}px * var(--s, 1))">{{ ingredients.size }} ingredient{% if ingredients.size > 1 %}s{% endif %}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
