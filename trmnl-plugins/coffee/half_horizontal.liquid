{% comment %} 800x240 (1040x390 on X) — wide but short, cup + text sit in a row.
  See full.liquid for how title_fit/count_scale work; target_w is this variant's real measured
  column width. Only div.layout + div.title_bar are authored here — TRMNL's platform injects the
  view/view--half_horizontal wrapper itself. {% endcomment %}
{% capture title_px_raw %}{% render "title_fit", name: name, target_w: 620, c: 0.72, min_px: 28, max_px: 70 %}{% endcapture %}
{% assign title_px = title_px_raw | strip | times: 1.0 | round %}
{% capture cs_raw %}{% render "count_scale", ingredients: ingredients %}{% endcapture %}
{% assign cs = cs_raw | strip | times: 1.0 %}
{% assign gap_px = 44 | times: cs | round %}
{% assign text_px = 24 | times: cs | round %}
{% assign cup_scale = 2.0 | times: cs %}
<div class="layout layout--row">
  <div class="coffee-content flex flex--row portrait:flex--col flex--center-x flex--center-y w--full h--full" style="gap:calc({{ gap_px }}px * var(--s, 1))">
    {% render "cup", ingredients: ingredients, total_ml: total_ml, scale: cup_scale %}
    <div class="coffee-meta">
      <h3 class="coffee-title" style="--fs:{{ title_px }}">{{ name }}</h3>
      {% render "ingredient_list", ingredients: ingredients, text_size: text_px %}
    </div>
  </div>
</div>

